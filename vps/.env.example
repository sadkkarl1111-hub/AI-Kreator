# Core
NODE_ENV=production
APP_URL=https://ai-kreator.pl
API_URL=https://ai-kreator.pl/api
ADMIN_URL=https://ai-kreator.pl/admin
FRONTEND_URL=https://ai-kreator.pl
PORT=3000

# Database
POSTGRES_PASSWORD=change_me_db_password
DATABASE_URL=postgresql://app_user:change_me_db_password@postgres:5432/kreator_ai

# Auth / JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ai-kreator.pl/api/auth/google/callback

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=Kreator Grafik AI <noreply@ai-kreator.pl>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Payments
PAYMENT_PROVIDER=payu

# PayU
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_ENVIRONMENT=production
# Optional override (default uses secure.payu.com or secure.snd.payu.com by PAYU_ENVIRONMENT)
PAYU_API_BASE=

# Tpay
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_MERCHANT_ID=
TPAY_SECURITY_CODE=
TPAY_API_BASE=https://api.tpay.com

# AI Providers
OPENAI_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
GEMINI_API_KEY=
SVG_GEMINI_API_KEY=
# Set true only to explicitly reuse the existing Gemini key (its billing tier applies).
SVG_AI_USE_EXISTING_GEMINI=false

# Captcha
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
HCAPTCHA_SECRET_KEY=

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=/app/storage
# UPLOAD_DIR is only used for local fallback / development.
PUBLIC_FILES_URL=https://ai-kreator.pl/api/files
# Cloudflare R2 / S3-compatible storage
# Set STORAGE_DRIVER=s3 and fill the fields below to store new files in R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MailerLite
MAILERLITE_API_KEY=

# KSeF
KSEF_ENABLED=true
KSEF_NIP=
KSEF_API_TOKEN=
KSEF_ENVIRONMENT=demo

# Background jobs
CRON_SECRET=change_me_cron_secret

# Rate limiting / cache
REDIS_URL=redis://redis:6379
DAILY_CREDIT_SPEND_LIMIT=500
